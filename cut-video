#!/usr/bin/env python3
"""cut-video: cut the beginning and end off a video at phrases found in its transcript. See README.md."""

import os
import sys

# Never write __pycache__ beside a video or anywhere else.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from videotools.cut_video import main  # noqa: E402

sys.exit(main())
